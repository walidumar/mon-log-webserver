ACCESS_REGEX = re.compile(
    r'^(?P<ip>\S+)\s+\S+\s+\S+\s+'
    r'\[(?P<time>[^\]]+)\]\s+'
    r'"(?P<request>[^"]*)"\s+'
    r'(?P<status>\d{3})\s+'
    r'(?P<size>\S+)'
    r'(?:\s+"(?P<referer>[^"]*)"\s+"(?P<agent>[^"]*)")?'
)

APACHE_ERROR_REGEX = re.compile(
    r'^\[(?P<time>[^\]]+)\]\s+'
    r'\[(?P<module>[^\]]+)\]\s*'
    r'(?:\[pid\s+(?P<pid>\d+)\])?\s*'
    r'(?P<message>.*)$'
)

NGINX_ERROR_REGEX = re.compile(
    r'^(?P<time>\d{4}/\d{2}/\d{2}\s+\d{2}:\d{2}:\d{2})\s+'
    r'\[(?P<level>[^\]]+)\]\s+'
    r'(?:\d+#\d+:\s*)?'
    r'(?P<message>.*)$'
)

