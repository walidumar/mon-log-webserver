    text-align: center;
    color: var(--muted);
    padding: 24px;
}
@media (max-width: 700px) {
    main { padding: 14px; }
    .grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<header>
<h1>Web Server Log Intelligence</h1>
<p id="subtitle">Loading...</p>
</header>

<main>
<section class="cards">
<div class="card"><div class="label">Total Requests</div><div class="value" id="requests">0</div></div>
<div class="card"><div class="label">HTTP 2xx</div><div class="value" id="s2xx">0</div></div>
<div class="card"><div class="label">HTTP 3xx</div><div class="value" id="s3xx">0</div></div>
<div class="card"><div class="label">HTTP 4xx</div><div class="value" id="s4xx">0</div></div>
<div class="card"><div class="label">HTTP 5xx</div><div class="value" id="s5xx">0</div></div>
<div class="card"><div class="label">Error Log</div><div class="value" id="errors">0</div></div>
<div class="card"><div class="label">Traffic</div><div class="value" id="traffic">0 B</div></div>
<div class="card"><div class="label">Security Risk</div><div class="value" id="risk">NORMAL</div></div>
</section>

<section class="grid">
<div class="panel">
<h2>Request Timeline</h2>
<div class="chart"><canvas id="timeline"></canvas></div>
</div>
<div class="panel">
<h2>HTTP Status</h2>
<div class="chart"><canvas id="status"></canvas></div>
</div>
<div class="panel">
<h2>HTTP Methods</h2>
<div class="chart"><canvas id="methods"></canvas></div>
</div>
<div class="panel">
<h2>Security Detection</h2>
<div class="chart"><canvas id="security"></canvas></div>
</div>
</section>

<section class="panel" style="margin-top:16px">
<h2>VirtualHost / Server Block</h2>
<div class="vhosts" id="vhosts"></div>
</section>

<section class="grid">
<div class="panel"><h2>Top IP Address</h2><table id="ips"><tbody></tbody></table></div>
<div class="panel"><h2>Top URL</h2><table id="urls"><tbody></tbody></table></div>
<div class="panel"><h2>Top User-Agent</h2><table id="agents"><tbody></tbody></table></div>
<div class="panel"><h2>Error Levels</h2><table id="levels"><tbody></tbody></table></div>
</section>

<section class="panel" style="margin-top:16px">
<h2>Security Events</h2>
<div id="events">No security event.</div>
</section>

<section class="panel" style="margin-top:16px">
<h2>Detected Log Files</h2>
<div id="files"></div>
</section>

<section class="panel" style="margin-top:16px">
<h2>Frequent Error Messages</h2>
<table id="errorMessages"><tbody></tbody></table>
</section>
</main>

<footer>
Last update: <span id="updated">-</span> · Auto refresh: 15 seconds
</footer>

<script>
let charts = {};

function n(v) {
    return new Intl.NumberFormat("id-ID").format(v || 0);
}
function bytes(v) {
    let x = Number(v || 0);
    const units = ["B","KB","MB","GB","TB"];
    let i = 0;
    while (x >= 1024 && i < units.length - 1) {
        x /= 1024; i++;
    }
    return x.toFixed(1) + " " + units[i];
}
function esc(v) {
    const d = document.createElement("div");
    d.textContent = v == null ? "" : String(v);
    return d.innerHTML;
}
function draw(id, type, labels, values) {
    const c = document.getElementById(id);
    const ctx = c.getContext("2d");
    if (charts[id]) charts[id].remove();
    const w = c.width = c.clientWidth * devicePixelRatio;
    const h = c.height = c.clientHeight * devicePixelRatio;
    ctx.scale(devicePixelRatio, devicePixelRatio);
    const width = c.clientWidth, height = c.clientHeight;
    const max = Math.max(...values, 1);

    ctx.clearRect(0, 0, width, height);
    ctx.font = "11px system-ui";
    ctx.fillStyle = "#8793a7";
    ctx.strokeStyle = "#253041";
    ctx.lineWidth = 1;

    if (type === "line" || type === "bar") {
        const left = 42, bottom = 30, top = 10;
        const chartW = width - left - 10;
        const chartH = height - bottom - top;
        ctx.beginPath();
        ctx.moveTo(left, top);
        ctx.lineTo(left, top + chartH);
        ctx.lineTo(width - 10, top + chartH);
        ctx.stroke();

        const count = Math.max(values.length, 1);
        values.forEach((v, i) => {
            const x = left + (i / Math.max(count - 1, 1)) * chartW;
            const y = top + chartH - (v / max) * chartH;
            if (type === "bar") {
                const bw = Math.max(3, chartW / count * 0.7);
                ctx.fillStyle = "#58a6ff";
                ctx.fillRect(x - bw / 2, y, bw, top + chartH - y);
            } else {
                ctx.fillStyle = "#58a6ff";
                ctx.beginPath();
                ctx.arc(x, y, 2, 0, Math.PI * 2);
                ctx.fill();
                if (i > 0) {
                    const pv = values[i - 1];
                    const px = left + ((i - 1) / Math.max(count - 1, 1)) * chartW;
                    const py = top + chartH - (pv / max) * chartH;
                    ctx.strokeStyle = "#58a6ff";
                    ctx.beginPath();
                    ctx.moveTo(px, py);
                    ctx.lineTo(x, y);
                    ctx.stroke();
                }
            }
        });

        if (labels.length) {
            ctx.fillStyle = "#8793a7";
            const step = Math.max(1, Math.ceil(labels.length / 6));
            labels.forEach((label, i) => {
                if (i % step === 0) {
                    const x = left + (i / Math.max(count - 1, 1)) * chartW;
                    ctx.fillText(label.slice(0, 16), Math.max(left, x - 30), height - 8);
                }
            });
        }
        charts[id] = {remove: () => {}};
        return;
    }

    const total = values.reduce((a,b) => a+b, 0) || 1;
    const cx = width / 2, cy = height / 2, radius = Math.min(width,height) * .32;
    let angle = -Math.PI / 2;
    const palette = ["#58a6ff","#3fb950","#d29922","#f85149","#bc8cff","#79c0ff","#ffa657","#56d364"];

    values.forEach((v, i) => {
        const next = angle + (v / total) * Math.PI * 2;
        ctx.fillStyle = palette[i % palette.length];
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, radius, angle, next);
        ctx.closePath();
        ctx.fill();
        angle = next;
    });

    ctx.fillStyle = "#111823";
    ctx.beginPath();
    ctx.arc(cx, cy, radius * .55, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = "#e7edf6";
    ctx.textAlign = "center";
    ctx.font = "bold 16px system-ui";
    ctx.fillText(n(total), cx, cy + 5);
    ctx.textAlign = "left";
    charts[id] = {remove: () => {}};
}

function table(id, data) {
    const body = document.querySelector("#" + id + " tbody");
    body.innerHTML = data.map(x =>
        `<tr><td>${esc(x[0])}</td><td>${n(x[1])}</td></tr>`
    ).join("");
}

function statusTotals(status) {
    const result = {2:0,3:0,4:0,5:0};
    Object.entries(status).forEach(([code,count]) => {
        const p = code.charAt(0);
        if (result[p] !== undefined) result[p] += count;
    });
    return result;
}

function renderVhosts(servers) {
    const box = document.getElementById("vhosts");
    let out = "";
    servers.forEach(server => {
        server.vhosts.forEach(v => {
            out += `
            <div class="vhost">
                <h3>${esc(v.name)}</h3>
                <span class="badge ${esc(v.risk)}">${esc(v.risk)}</span>
                <div class="stat"><span>Server</span><strong>${esc(server.server)}</strong></div>
                <div class="stat"><span>Requests</span><strong>${n(v.requests)}</strong></div>
                <div class="stat"><span>Errors</span><strong>${n(v.errors)}</strong></div>
                <div class="stat"><span>Traffic</span><strong>${bytes(v.bytes)}</strong></div>
                <div class="stat"><span>Score</span><strong>${v.score}/100</strong></div>
                <div style="margin-top:8px;color:#8793a7;font-size:11px">
                    ${v.access_files.map(x => "ACCESS · " + esc(x)).join("<br>")}
                    ${v.error_files.map(x => "ERROR · " + esc(x)).join("<br>")}
                </div>
            </div>`;
        });
    });
    box.innerHTML = out || "<p>Tidak ada VHost terdeteksi.</p>";
}

function renderFiles(servers) {
    const box = document.getElementById("files");
    let out = "";
    servers.forEach(s => s.files.forEach(f => {
        out += `<div class="event">
            <strong>${esc(s.server)}</strong> · ${esc(f.type)}
            · ${esc(f.vhost)} · ${bytes(f.size)}
            <small>${esc(f.path)} · ${esc(f.modified)}</small>
        </div>`;
    }));
    box.innerHTML = out || "Tidak ada file log terdeteksi.";
}

function renderEvents(events) {
    const box = document.getElementById("events");
    if (!events.length) {
        box.textContent = "Tidak ada pola aktivitas mencurigakan yang terdeteksi.";
        return;
    }
    box.innerHTML = events.map(e => `
        <div class="event">
            <strong>${esc(e.type)}</strong>
            · ${esc(e.ip)}
            · HTTP ${e.status}
            · VHost ${esc(e.vhost)}
            <small>${esc(e.method)} ${esc(e.url)}</small>
            <small>Source: ${esc(e.source)}</small>
            <small>${esc(e.agent)}</small>
        </div>
    `).join("");
}

async function update() {
    try {
        const response = await fetch("/api/data", {cache:"no-store"});
        const d = await response.json();

        document.getElementById("subtitle").textContent =
            `${d.hostname} · ${d.servers.length} web server instance · ${d.files} log files`;

        document.getElementById("requests").textContent = n(d.requests);
        document.getElementById("errors").textContent = n(d.errors);
        document.getElementById("traffic").textContent = bytes(d.bytes);
        document.getElementById("risk").textContent = d.risk;

        const s = statusTotals(d.status);
        document.getElementById("s2xx").textContent = n(s[2]);
        document.getElementById("s3xx").textContent = n(s[3]);
        document.getElementById("s4xx").textContent = n(s[4]);
        document.getElementById("s5xx").textContent = n(s[5]);

        const timeline = Object.entries(d.timeline).sort();
        draw("timeline", "line", timeline.map(x=>x[0]), timeline.map(x=>x[1]));

        const status = Object.entries(d.status).sort();
        draw("status", "doughnut", status.map(x=>x[0]), status.map(x=>x[1]));

        draw("methods", "doughnut", d.methods.map(x=>x[0]), d.methods.map(x=>x[1]));

        const security = Object.entries(d.security).sort((a,b)=>b[1]-a[1]);
        draw("security", "bar", security.map(x=>x[0]), security.map(x=>x[1]));

        table("ips", d.ips);
        table("urls", d.urls);
        table("agents", d.agents);
        table("levels", d.error_levels);
        table("errorMessages", d.error_messages);

        renderVhosts(d.servers);
        renderFiles(d.servers);
        renderEvents(d.events);

        document.getElementById("updated").textContent = d.generated_at;
    } catch (error) {
        console.error(error);
    }
}

update();
setInterval(update, 15000);
window.addEventListener("resize", update);
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def send_text(self, body, content_type="text/html; charset=utf-8", status=200):
        payload = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self):
        parsed = urlparse(self.path)

        if parsed.path == "/":
            self.send_text(HTML)
            return

        if parsed.path == "/api/data":
            data = analyze_all()
            self.send_text(
                json.dumps(data, ensure_ascii=False),
                "application/json; charset=utf-8",
            )
            return

        if parsed.path == "/health":
            self.send_text(
                json.dumps({"status": "ok", "version": VERSION}),
                "application/json; charset=utf-8",
            )
            return

        self.send_text("Not Found", "text/plain; charset=utf-8", 404)


SERVER = None


def stop_server(signum=None, frame=None):
    global SERVER
    if SERVER:
        print("\nStopping mon-log...")
        threading.Thread(
            target=SERVER.shutdown,
            daemon=True
        ).start()


def run_server(port):
    global SERVER

    try:
        SERVER = ThreadingHTTPServer((HOST, port), Handler)
    except OSError as exc:
        eprint(f"Gagal membuka port {port}: {exc}")
        eprint("Gunakan port lain dengan: mon-log --port 9090")
        sys.exit(1)

    signal.signal(signal.SIGINT, stop_server)
    signal.signal(signal.SIGTERM, stop_server)

    print(f"\n{APP_NAME} {VERSION}")
    print("=" * 72)
    print(f"Dashboard : http://{HOST}:{port}")
    print(f"Hostname  : {socket.gethostname()}")
    print("Mode      : foreground")
    print("Refresh   : 15 seconds")
    print()
    print("Tekan CTRL+C untuk berhenti.")
    print("=" * 72)

    try:
        SERVER.serve_forever()
    finally:
        SERVER.server_close()
        SERVER = None
        print("Stopped.")


def main():
    parser = argparse.ArgumentParser(
        description="Web Server Log Intelligence - Apache2/Nginx"
    )

    parser.add_argument(
        "--port",
        type=int,
        default=PORT,
        help=f"Port dashboard (default: {PORT})",
    )

    parser.add_argument(
        "--summary",
        action="store_true",
        help="Tampilkan ringkasan di terminal dan keluar.",
    )

    parser.add_argument(
        "--detect",
        action="store_true",
        help="Tampilkan file log yang berhasil dideteksi dan keluar.",
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {VERSION}",
    )

    args = parser.parse_args()

    if args.detect:
        print_detect()
        return

    if args.summary:
        print_summary(analyze_all())
        return

    run_server(args.port)


if __name__ == "__main__":
    main()
