ACCESS_NAME_HINTS = (
    "access", "request", "requests", "traffic", "http", "web"
)
ERROR_NAME_HINTS = (
    "error", "errors", "err"
)


def eprint(*args):
    print(*args, file=sys.stderr)


def safe_int(value, default=0):
    try:
        return int(value)
    except Exception:
        return default


def human_bytes(value):
    value = float(value or 0)
    units = ("B", "KB", "MB", "GB", "TB")
    index = 0
    while value >= 1024 and index < len(units) - 1:
        value /= 1024
        index += 1
    return f"{value:.1f} {units[index]}"


def risk_level(score):
    if score >= 80:
        return "CRITICAL"
    if score >= 60:
        return "HIGH"
    if score >= 30:
        return "MEDIUM"
    if score > 0:
        return "LOW"
    return "NORMAL"


def discover_files(directory):
    patterns = [
        os.path.join(directory, "*"),
        os.path.join(directory, ".*"),
    ]
    files = set()

    for pattern in patterns:
        for path in glob.glob(pattern):
            if not os.path.isfile(path):
                continue
            name = os.path.basename(path).lower()
            if name in (".", ".."):
                continue
            # Skip obvious non-log files. Unknown names are still allowed
            # when they have log-like content.
            if (
                name.endswith((".log", ".gz"))
                or ".log." in name
                or "access" in name
                or "error" in name
                or "request" in name
                or "traffic" in name
            ):
                files.add(path)

    return sorted(
        files,
        key=lambda p: os.path.getmtime(p) if os.path.exists(p) else 0,
        reverse=True,
    )


def read_lines(path, limit=MAX_LINES_PER_FILE):
    try:
        opener = gzip.open if path.lower().endswith(".gz") else open
        mode = "rt"
        with opener(path, mode, encoding="utf-8", errors="replace") as fh:
            for index, line in enumerate(fh):
                if index >= limit:
                    break
                yield line.rstrip("\n")
    except (PermissionError, OSError):
        return


def sample_lines(path):
    result = []
    for line in read_lines(path, SAMPLE_LINES):
        if line.strip():
            result.append(line)
    return result


def parse_access(line):
    match = ACCESS_REGEX.match(line)
    if not match:
        return None

    request = match.group("request") or ""
    parts = request.split()

    return {
        "ip": match.group("ip"),
        "time": match.group("time"),
        "method": parts[0] if len(parts) > 0 else "-",
        "url": parts[1] if len(parts) > 1 else "-",
        "protocol": parts[2] if len(parts) > 2 else "-",
        "status": safe_int(match.group("status")),
        "size": 0 if match.group("size") == "-" else safe_int(match.group("size")),
        "referer": match.group("referer") or "-",
        "agent": match.group("agent") or "-",
    }


def parse_error(line, server):
    if server == "Apache2":
        match = APACHE_ERROR_REGEX.match(line)
        if not match:
            return None
        return {
            "time": match.group("time"),
            "level": match.group("module"),
            "message": match.group("message"),
        }

    if server == "Nginx":
        match = NGINX_ERROR_REGEX.match(line)
        if not match:
            return None
        return {
            "time": match.group("time"),
            "level": match.group("level"),
            "message": match.group("message"),
        }

    return None


def classify_file(path, server):
    """
    Smart classifier:
    1. filename hints
    2. access/error content signatures
    3. returns access/error/unknown
    """
    name = os.path.basename(path).lower()

    for hint in ACCESS_NAME_HINTS:
        if hint in name:
            return "access"

    for hint in ERROR_NAME_HINTS:
        if hint in name:
            return "error"

    access_score = 0
    error_score = 0

    for line in sample_lines(path):
        if ACCESS_REGEX.match(line):
            access_score += 10

        if re.search(
            r'"(?:GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|CONNECT)\s+\S+',
            line,
            re.I,
        ):
            access_score += 4

        if re.search(r'"\s+\d{3}\s+\S+', line):
            access_score += 4

        if APACHE_ERROR_REGEX.match(line):
            error_score += 10

        if NGINX_ERROR_REGEX.match(line):
            error_score += 10

        if re.search(
            r'\[(error|warn|notice|crit|alert|emerg)\]',
            line,
            re.I,
        ):
            error_score += 4

    if access_score > error_score and access_score >= 8:
        return "access"
    if error_score > access_score and error_score >= 8:
        return "error"
    return "unknown"


def vhost_from_filename(path):
    name = os.path.basename(path).lower()
    name = re.sub(r"\.gz$", "", name)
    name = re.sub(r"\.\d+$", "", name)

    patterns = (
        r"[-_]?access(?:log)?\.log$",
        r"[-_]?error(?:s)?\.log$",
        r"[-_]?requests?\.log$",
        r"[-_]?traffic\.log$",
    )

    for pattern in patterns:
        name = re.sub(pattern, "", name, flags=re.I)

    if name in ("", "access", "error", "requests", "request", "traffic"):
        return "default"

    return name


def security_events(url, agent, method):
    text = f"{url} {agent}"
    found = []

    for category, patterns in SECURITY_PATTERNS.items():
        for pattern in patterns:
            try:
                if re.search(pattern, text, re.I):
                    found.append(category)
                    break
            except re.error:
                continue

    if method.upper() not in {
        "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "CONNECT"
    }:
        found.append("Abnormal HTTP Method")

    if len(url) > 2048:
        found.append("Abnormally Long URL")

    return list(dict.fromkeys(found))


def security_score(security, status):
    score = 0
    score += min(security.get("SQL Injection", 0) * 5, 30)
    score += min(security.get("Command Injection", 0) * 8, 30)
    score += min(security.get("Path Traversal", 0) * 5, 20)
    score += min(security.get("Sensitive File Probe", 0) * 2, 15)
    score += min(security.get("Common Scanner", 0) * 2, 10)
    score += min(security.get("XSS Attempt", 0) * 4, 20)
    score += min(status.get("500", 0) // 20, 10)
    return min(score, 100)


def empty_vhost():
    return {
        "requests": 0,
        "errors": 0,
        "bytes": 0,
        "status": Counter(),
        "methods": Counter(),
        "ips": Counter(),
        "urls": Counter(),
        "security": Counter(),
        "access_files": [],
        "error_files": [],
        "events": [],
    }


def analyze_server(server, directory):
    result = {
        "server": server,
        "directory": directory,
        "files": [],
        "vhosts": {},
        "requests": 0,
        "errors": 0,
        "bytes": 0,
        "status": Counter(),
        "methods": Counter(),
        "ips": Counter(),
        "urls": Counter(),
        "agents": Counter(),
        "referers": Counter(),
        "timeline": Counter(),
        "security": Counter(),
        "events": [],
        "error_levels": Counter(),
        "error_messages": Counter(),
        "parse_failures": 0,
    }

    for path in discover_files(directory):
        log_type = classify_file(path, server)
        if log_type == "unknown":
            continue

        vhost = vhost_from_filename(path)
        result["vhosts"].setdefault(vhost, empty_vhost())
        vh = result["vhosts"][vhost]

        try:
            size = os.path.getsize(path)
            modified = datetime.fromtimestamp(
                os.path.getmtime(path)
            ).strftime("%Y-%m-%d %H:%M:%S")
        except OSError:
            size = 0
            modified = "-"

        result["files"].append({
            "path": path,
            "type": log_type,
            "vhost": vhost,
            "size": size,
            "modified": modified,
        })

        if log_type == "access":
            vh["access_files"].append(path)

            for line in read_lines(path):
                parsed = parse_access(line)
                if not parsed:
                    result["parse_failures"] += 1
                    continue

                result["requests"] += 1
                result["bytes"] += parsed["size"]
                result["status"][str(parsed["status"])] += 1
                result["methods"][parsed["method"]] += 1
                result["ips"][parsed["ip"]] += 1
                result["urls"][parsed["url"]] += 1
                result["agents"][parsed["agent"]] += 1
                result["referers"][parsed["referer"]] += 1

                vh["requests"] += 1
                vh["bytes"] += parsed["size"]
                vh["status"][str(parsed["status"])] += 1
                vh["methods"][parsed["method"]] += 1
                vh["ips"][parsed["ip"]] += 1
                vh["urls"][parsed["url"]] += 1

                try:
                    stamp = parsed["time"].split()[0]
                    dt = datetime.strptime(
                        stamp, "%d/%b/%Y:%H:%M:%S"
                    )
                    result["timeline"][dt.strftime("%Y-%m-%d %H:00")] += 1
                except Exception:
                    pass

                detections = security_events(
                    parsed["url"],
                    parsed["agent"],
                    parsed["method"],
                )

                for detection in detections:
                    result["security"][detection] += 1
                    vh["security"][detection] += 1

                    event = {
                        "server": server,
                        "vhost": vhost,
                        "source": os.path.basename(path),
                        "ip": parsed["ip"],
                        "method": parsed["method"],
                        "url": parsed["url"],
                        "status": parsed["status"],
                        "type": detection,
                        "agent": parsed["agent"],
                    }

                    if len(result["events"]) < MAX_SECURITY_EVENTS:
                        result["events"].append(event)

                    if len(vh["events"]) < MAX_SECURITY_EVENTS:
                        vh["events"].append(event)

        elif log_type == "error":
            vh["error_files"].append(path)

            for line in read_lines(path):
                parsed = parse_error(line, server)
                if not parsed:
                    result["parse_failures"] += 1
                    continue

                result["errors"] += 1
                vh["errors"] += 1
                result["error_levels"][parsed["level"]] += 1

                message = parsed["message"]
                if len(message) > 500:
                    message = message[:500] + "..."
                result["error_messages"][message] += 1

    result["score"] = security_score(
        result["security"], result["status"]
    )
    result["risk"] = risk_level(result["score"])

    for vh in result["vhosts"].values():
        vh["score"] = security_score(
            vh["security"], vh["status"]
        )
        vh["risk"] = risk_level(vh["score"])

    return result


def top_list(counter, limit=20):
    return [[key, value] for key, value in counter.most_common(limit)]


def serialize_server(data):
    vhosts = []

    for name, vh in sorted(data["vhosts"].items()):
        vhosts.append({
            "name": name,
            "requests": vh["requests"],
            "errors": vh["errors"],
            "bytes": vh["bytes"],
            "status": dict(vh["status"]),
            "methods": top_list(vh["methods"], 10),
            "ips": top_list(vh["ips"], 15),
            "urls": top_list(vh["urls"], 15),
            "security": dict(vh["security"]),
            "score": vh["score"],
            "risk": vh["risk"],
            "access_files": [os.path.basename(x) for x in vh["access_files"]],
            "error_files": [os.path.basename(x) for x in vh["error_files"]],
            "events": vh["events"][:50],
        })

    return {
        "server": data["server"],
        "directory": data["directory"],
        "files": data["files"],
        "vhosts": vhosts,
        "requests": data["requests"],
        "errors": data["errors"],
        "bytes": data["bytes"],
        "status": dict(data["status"]),
        "methods": top_list(data["methods"], 15),
        "ips": top_list(data["ips"], 20),
        "urls": top_list(data["urls"], 20),
        "agents": top_list(data["agents"], 15),
        "referers": top_list(data["referers"], 15),
        "timeline": dict(data["timeline"]),
        "security": dict(data["security"]),
        "events": data["events"][:100],
        "error_levels": top_list(data["error_levels"], 20),
        "error_messages": top_list(data["error_messages"], 20),
        "score": data["score"],
        "risk": data["risk"],
        "parse_failures": data["parse_failures"],
    }


def analyze_all():
    servers = []
    global_status = Counter()
    global_methods = Counter()
    global_ips = Counter()
    global_urls = Counter()
    global_agents = Counter()
    global_referers = Counter()
    global_timeline = Counter()
    global_security = Counter()
    global_levels = Counter()
    global_errors = Counter()
    global_events = []

    total_requests = 0
    total_errors = 0
    total_bytes = 0
    total_files = 0
    total_parse_failures = 0

    for server, directories in LOG_DIRS.items():
        for directory in directories:
            if not os.path.isdir(directory):
                continue

            files = discover_files(directory)
            if not files:
                continue

            data = analyze_server(server, directory)

            if not data["files"]:
                continue

            servers.append(serialize_server(data))
            total_files += len(data["files"])
            total_requests += data["requests"]
            total_errors += data["errors"]
            total_bytes += data["bytes"]
            total_parse_failures += data["parse_failures"]

            global_status.update(data["status"])
            global_methods.update(data["methods"])
            global_ips.update(data["ips"])
            global_urls.update(data["urls"])
            global_agents.update(data["agents"])
            global_referers.update(data["referers"])
            global_timeline.update(data["timeline"])
            global_security.update(data["security"])
            global_levels.update(data["error_levels"])
            global_errors.update(data["error_messages"])

            global_events.extend(data["events"])

    score = security_score(global_security, global_status)

    return {
        "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "hostname": socket.gethostname(),
        "requests": total_requests,
        "errors": total_errors,
        "bytes": total_bytes,
        "files": total_files,
        "parse_failures": total_parse_failures,
        "status": dict(global_status),
        "methods": top_list(global_methods, 15),
        "ips": top_list(global_ips, 20),
        "urls": top_list(global_urls, 20),
        "agents": top_list(global_agents, 15),
        "referers": top_list(global_referers, 15),
        "timeline": dict(global_timeline),
        "security": dict(global_security),
        "events": global_events[:100],
        "error_levels": top_list(global_levels, 20),
        "error_messages": top_list(global_errors, 20),
        "score": score,
        "risk": risk_level(score),
        "servers": servers,
    }


def print_detect():
    print(f"\n{APP_NAME} {VERSION}")
    print("=" * 72)

    found = False

    for server, directories in LOG_DIRS.items():
        for directory in directories:
            if not os.path.isdir(directory):
                continue

            print(f"\n[{server}] {directory}")

            for path in discover_files(directory):
                log_type = classify_file(path, server)
                if log_type == "unknown":
                    continue

                found = True
                vhost = vhost_from_filename(path)

                try:
                    size = human_bytes(os.path.getsize(path))
                except OSError:
                    size = "-"

                print(
                    f"  {log_type.upper():6} "
                    f"{vhost:20} "
                    f"{size:>10}  "
                    f"{path}"
                )

    if not found:
        print("\nTidak ada log yang berhasil dideteksi.")

    print()


def print_summary(data):
    print(f"\n{APP_NAME} {VERSION}")
    print("=" * 72)
    print(f"Host          : {data['hostname']}")
    print(f"Log files     : {data['files']}")
    print(f"Requests      : {data['requests']:,}")
    print(f"Errors        : {data['errors']:,}")
    print(f"Traffic       : {human_bytes(data['bytes'])}")
    print(f"Security      : {data['risk']} ({data['score']}/100)")
    print()

    status = data["status"]
    for prefix in ("2", "3", "4", "5"):
        total = sum(
            value for code, value in status.items()
            if code.startswith(prefix)
        )
        print(f"HTTP {prefix}xx      : {total:,}")

    print("\nTop IP:")
    for key, value in data["ips"][:10]:
        print(f"  {value:8,}  {key}")

    print("\nSecurity:")
    if data["security"]:
        for key, value in sorted(
            data["security"].items(),
            key=lambda item: item[1],
            reverse=True,
        ):
            print(f"  {value:8,}  {key}")
    else:
        print("  Tidak ada pola mencurigakan yang terdeteksi.")

    print("\nVHost:")
    for server in data["servers"]:
        for vh in server["vhosts"]:
            print(
                f"  {server['server']:8} "
                f"{vh['name']:20} "
                f"{vh['requests']:10,} requests  "
                f"{vh['risk']}"
            )

    print()


