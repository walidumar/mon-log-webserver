.HIGH, .CRITICAL { color: var(--danger); background: #2b1212; }
table { width: 100%; border-collapse: collapse; }
th, td {
    padding: 8px;
    border-bottom: 1px solid #202a38;
    text-align: left;
    vertical-align: top;
}
th { color: var(--muted); font-weight: 500; }
pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--muted);
}
