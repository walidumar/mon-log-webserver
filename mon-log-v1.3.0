<button class="range" data-range="86400">24h</button>
</div>
</div>
</div>
<div class="two section">
<div class="card"><div class="cardtitle"><h2>Request Trend</h2><span class="badge" id="trendBadge">LIVE • 5 min • 5 sec</span></div><div class="legend"><span class="hits">Hits</span><span class="errors">Errors</span></div><div class="chart"><svg id="trend" viewBox="0 0 900 245" preserveAspectRatio="none"></svg></div></div>
<div class="card"><div class="cardtitle"><h2>HTTP Status Distribution</h2><span class="badge">All access logs</span></div><div class="donutbox"><div class="donut" id="donut"><div class="donutcenter"><b id="statusTotal">0</b><span>responses</span></div></div><div class="legendlist" id="statusLegend"></div></div></div>
</div>
<div class="three section">
<div class="card"><div class="cardtitle"><h2>Top Request Path</h2></div><div class="scroll" id="paths"></div></div>
<div class="card"><div class="cardtitle"><h2>Top Client IP</h2></div><div class="scroll" id="iplist"></div></div>
<div class="card"><div class="cardtitle"><h2>HTTP Method</h2></div><div class="barlist" id="methods"></div></div>
</div>
<div class="card section"><div class="cardtitle"><h2>Domain / VHost Statistics</h2><span class="badge">Access + Error + Traffic</span></div><div class="scroll"><table><thead><tr><th>Domain / VHost</th><th>Hits</th><th>Errors</th><th>Traffic</th><th>Status</th></tr></thead><tbody id="domainTable"></tbody></table></div></div>
<div class="card section"><div class="cardtitle"><h2>Detected Log Files</h2><span class="badge" id="logBadge">0 files</span></div><div class="scroll"><table><thead><tr><th>Type</th><th>Log File</th><th>Domain</th><th>Hits</th><th>Errors</th></tr></thead><tbody id="files"></tbody></table></div></div>
<div class="footer">Server: <span id="server">-</span> • Last update: <span id="updated">-</span> • Auto refresh: 5 seconds</div>
</main>
<script>
const E=s=>String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
const F=n=>Number(n||0).toLocaleString();
function list(o){return Object.entries(o||{}).map(([k,v])=>`<div class="row"><span>${E(k)}</span><b>${F(v)}</b></div>`).join('')||'<span style="color:#718598">No data</span>'}
function drawTrend(h){
 const svg=document.getElementById("trend");if(!h.length){svg.innerHTML="";return}
 const W=900,H=245,p=28,max=Math.max(1,...h.map(x=>Math.max(x.hits,x.errors)));
 const line=k=>h.map((x,i)=>{const X=p+i*(W-2*p)/Math.max(1,h.length-1),Y=H-p-(x[k]/max)*(H-2*p);return X+","+Y}).join(" ");
 let grid="";for(let i=1;i<=4;i++){let y=H-p-(i/4)*(H-2*p);grid+=`<line x1="${p}" y1="${y}" x2="${W-p}" y2="${y}" stroke="#182532"/><text x="4" y="${y+3}" fill="#607487" font-size="9">${F(Math.round(max*i/4))}</text>`}
 svg.innerHTML=grid+`<polyline fill="none" stroke="#31a8ff" stroke-width="3" points="${line("hits")}"/><polyline fill="none" stroke="#ff5364" stroke-width="2.5" points="${line("errors")}"/><text x="${p}" y="${H-5}" fill="#607487" font-size="9">${E(h[0].time)}</text><text x="${W-p}" y="${H-5}" text-anchor="end" fill="#607487" font-size="9">${E(h[h.length-1].time)}</text>`;
}
function drawStatus(o){
 const entries=Object.entries(o||{}).sort((a,b)=>Number(b[0])-Number(a[0]));const total=entries.reduce((a,x)=>a+x[1],0);
 document.getElementById("statusTotal").textContent=F(total);
 const colors=["#27d17f","#35d7ff","#ff8c42","#ff5364"];let acc=0,stops=[];
 entries.forEach((x,i)=>{let pct=total?x[1]/total*100:0;stops.push(`${colors[i%4]} ${acc}% ${acc+pct}%`);acc+=pct});
 document.getElementById("donut").style.background=`conic-gradient(${stops.join(",")||"#17232f 0 100%"})`;
 document.getElementById("statusLegend").innerHTML=entries.slice(0,6).map((x,i)=>{let pct=total?(x[1]/total*100).toFixed(1):0;return `<div class="legendrow"><span><i class="dot ${["ok","info","warnc","bad"][i%4]}"></i>${E(x[0])}</span><b>${F(x[1])} <small style="color:#718598">${pct}%</small></b></div>`}).join('');
}
function drawMethods(o){
 const a=Object.entries(o||{}).slice(0,7),max=Math.max(...a.map(x=>x[1]),1);
 document.getElementById("methods").innerHTML=a.map(([k,v])=>`<div class="barrow"><span>${E(k)}</span><div class="barbg"><div class="barfill" style="width:${v/max*100}%"></div></div><span class="value-sm">${F(v)}</span></div>`).join('')||'<span style="color:#718598">No data</span>';
}
function drawDomains(d){
 const rows=Object.entries(d||{}).map(([name,v])=>{const status=v.errors>100?'HIGH':v.errors>20?'MEDIUM':'LOW';const cls=status==='HIGH'?'status-high':status==='MEDIUM'?'status-medium':'status-low';return `<tr><td>${E(name)}</td><td>${F(v.access)}</td><td>${F(v.errors)}</td><td>-</td><td class="${cls}">${status}</td></tr>`});
 document.getElementById("domainTable").innerHTML=rows.join('')||'<tr><td colspan="5">No domain detected</td></tr>';
}
let graphRange=300;
document.querySelectorAll('.range').forEach(btn=>btn.addEventListener('click',()=>{
 graphRange=Number(btn.dataset.range)||300;
 document.querySelectorAll('.range').forEach(x=>x.classList.remove('active'));
 btn.classList.add('active');
 load();
}));
async function load(){
 try{
  document.getElementById('refreshState').textContent='• updating';
  const d=await(await fetch('/api/stats?range='+graphRange,{cache:'no-store'})).json(),s=d.summary;
  document.getElementById('ver').textContent=d.version;document.getElementById('hits').textContent=F(s.hits);document.getElementById('errors').textContent=F(s.errors);
  document.getElementById('af').textContent=F(s.access_files);document.getElementById('ef').textContent=F(s.error_files);document.getElementById('traffic').textContent=s.traffic;
  document.getElementById('ips').textContent=F(s.unique_ips);document.getElementById('urls').textContent=F(s.unique_paths);document.getElementById('domains').textContent=F(s.domains);
  document.getElementById('server').textContent=d.server_ip;
  document.getElementById('updated').textContent=d.generated_at;
  document.getElementById('os').textContent=d.system?.os||'-';
  document.getElementById('kernel').textContent='Kernel '+(d.system?.kernel||'-');
  document.getElementById('kernelArch').textContent=(d.system?.kernel||'-')+' / '+(d.system?.architecture||'-');
  document.getElementById('python').textContent='Python '+(d.system?.python||'-');
  const ws=(d.system?.webservers||[]);
  document.getElementById('webserver').textContent=ws.length?ws.map(x=>x.name+' '+x.version).join(' / '):'Not detected';
  document.getElementById('webserverPath').textContent=ws.length?ws.map(x=>x.path).join(' • '):'Check PATH';document.getElementById('logBadge').textContent=F(s.log_files)+' files';
  document.getElementById('paths').innerHTML=list(d.top_paths);document.getElementById('iplist').innerHTML=list(d.top_ips);
  document.getElementById('trendBadge').textContent='LIVE • '+(graphRange<3600?Math.round(graphRange/60)+' min':Math.round(graphRange/3600)+' h')+' • 5 sec';drawTrend(d.history||[]);drawStatus(d.statuses);drawMethods(d.methods);drawDomains(d.domains);
  document.getElementById('files').innerHTML=d.files.map(x=>`<tr><td>${E(x.kind)}</td><td>${E(x.file)}</td><td>${E(x.domain)}</td><td>${F(x.hits)}</td><td>${F(x.errors)}</td></tr>`).join('');
  document.getElementById('refreshState').textContent='• updated';
  }catch(e){
   document.getElementById('refreshState').textContent='• connection error';
   document.getElementById('updated').textContent='connection error'
  }
}
load();setInterval(load,5000);
</script>
</body></html>'''


class Handler(BaseHTTPRequestHandler):
    def log_message(self,*args): pass
    def send_data(self,data,ctype="text/html; charset=utf-8",code=200):
        data=data.encode() if isinstance(data,str) else data; self.send_response(code)
        self.send_header("Content-Type",ctype); self.send_header("Content-Length",str(len(data))); self.send_header("Cache-Control","no-store"); self.end_headers(); self.wfile.write(data)
    def do_GET(self):
        path=urlparse(self.path).path
        if path in ("/","/index.html"): self.send_data(HTML)
        elif path=="/api/stats":
            with lock:
                data=dict(latest)
                h=list(history)
            # Filter graph history server-side to avoid sending a full 24-hour
            # series on every 5-second refresh.
            q=urlparse(self.path).query
            from urllib.parse import parse_qs
            params=parse_qs(q)
            try:
                seconds=int(params.get("range",["900"])[0])
            except ValueError:
                seconds=900
            if seconds>0:
                cutoff=time.time()-seconds
                filtered=[]
                for item in h:
                    try:
                        ts=datetime.strptime(item["time"],"%Y-%m-%d %H:%M:%S").timestamp()
                        if ts>=cutoff: filtered.append(item)
                    except Exception: pass
                data["history"]=filtered
            else:
                data["history"]=h
            self.send_data(json.dumps(data),"application/json")
        else: self.send_data("Not Found","text/plain",404)

def stop(*args):
    global running; running=False
    try: httpd.shutdown()
    except Exception: pass

def main():
    global latest,httpd
    if os.geteuid()!=0: print("Warning: gunakan sudo agar semua log dapat dibaca.\n")
    ip=get_ip()
    print(f"\nWeb Server Log Intelligence {VERSION}\n"+"="*72)
    print(f"Dashboard : http://{ip}:{PORT}")
    print(f"Hostname  : {socket.gethostname()}")
    print("Domain    : Detecting...")
    print("Mode      : foreground"); print(f"Refresh   : {REFRESH} seconds"); print("="*72)
    try: httpd=ThreadingHTTPServer((HOST,PORT),Handler); httpd.daemon_threads=True
    except OSError as e: print(f"ERROR: port {PORT} tidak dapat digunakan: {e}"); sys.exit(1)
    threading.Thread(target=httpd.serve_forever,daemon=True).start()
    signal.signal(signal.SIGINT,stop); signal.signal(signal.SIGTERM,stop)
    while running:
        try:
            d=make_snapshot()
            with lock: latest=d
            add_history(d)
            show_console(d)
            for _ in range(REFRESH):
                if not running: break
                time.sleep(1)
        except KeyboardInterrupt: stop()
        except Exception as e: print(f"Analyzer error: {e}"); time.sleep(3)
    httpd.server_close(); print("\nStopped.")

if __name__=="__main__": main()
