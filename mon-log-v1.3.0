<div class="card kpi"><div class="label">Python Runtime</div><div class="value" id="python" style="font-size:16px">-</div><div class="delta">Standard Library</div></div>
</div>
<div class="grid section">
<div class="card kpi"><div class="label">Unique Client IP</div><div class="value" id="ips">0</div><div class="delta">Distinct sources</div></div>
<div class="card kpi"><div class="label">Unique URL</div><div class="value" id="urls">0</div><div class="delta">Request paths</div></div>
